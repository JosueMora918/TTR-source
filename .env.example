APP_NAME=TTR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ttr.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ttr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Los correos (recuperación de contraseña) se escriben en storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@ttr.test"
MAIL_FROM_NAME="${APP_NAME}"

# Solo para el seeder en producción (en local se usan las credenciales de demostración)
# TTR_ADMIN_EMAIL=admin@tudominio.com
# TTR_ADMIN_PASSWORD=una-clave-segura
